$DEC_PROGRAM  -c "-mp4ff dm=1 tm=1" $BIT_DIR/er_hv01_ep0.mp4
$CMP_DIR/hvxc_fcomp -r 2000 test.wav $REF_DIR/hv01ref1.wav

