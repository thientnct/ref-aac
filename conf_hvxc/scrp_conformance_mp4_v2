#
# an example of shell script to test decoder conformance 
# using ref.software
#
# USAGE: scrp_conformance_mp4_v2 <number> 
#
#	number:	0	all test
#		1	all voiced bit stream(2kbps) 	: er_hv01_ep0
#		2	all voiced bit stream(4kbps) 	: er_hv02_ep0
#		3	all unvoiced bit stream(2kbps)	: er_hv03_ep0
#		4	all unvoiced bit stream(4kbps)	: er_hv04_ep0
