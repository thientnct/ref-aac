# disable G723 dummy
OBJS_DEC_G723 =
OBJS_ENC_G723 =
OBJS_ALL_G723 =

# G723 mode
OBJS_ENC_G723 +=codcng2.o\
		coder2.o\
		deccng2.o\
		decod2.o\
		exc2.o\
		lpc2.o\
		lsp2.o\
		tab2.o\
		util2.o\
		utilcng2.o\
		vad2.o\
		g723_coder.o\
		enc_g723.o

OBJS_DEC_G723 +=codcng2.o\
		coder2.o\
		deccng2.o\
		decod2.o\
		exc2.o\
		lpc2.o\
		lsp2.o\
		tab2.o\
		util2.o\
		utilcng2.o\
		vad2.o\
		g723_decoder.o\
		dec_g723.o

OBJS_ALL_G723 +=codcng2.o\
		coder2.o\
		deccng2.o\
		decod2.o\
		exc2.o\
		lpc2.o\
		lsp2.o\
		tab2.o\
		util2.o\
		utilcng2.o\
		vad2.o\
		g723_coder.o\
		enc_g723.o \
		g723_decoder.o\
		dec_g723.o
# end of makefile.g723

